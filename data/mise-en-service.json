        "formation"
      ]
    },
    {
      "id": "br:7.1",
      "procedure": "br",
      "numero": "7",
      "marque": "brompton",
      "texte": "Contrôler l'OSD de chaque dalle : température, statut, module en cause.",
      "sources": [
        "formation"
      ]
    },
    {
      "id": "br:7.2",
      "procedure": "br",
      "numero": "7",
      "marque": "brompton",
